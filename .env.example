# Copy to .env for local use. Never commit .env or real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://rag:rag_local_only@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

# Defaults are configurable; changing embedding model/dimensions requires re-embedding.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=20
RRF_K=60

# Set provider/model/key only for answer generation. Retrieval-only mode needs no key.
GENERATION_PROVIDER=none
GENERATION_MODEL=
GENERATION_API_BASE=
GENERATION_API_KEY=

MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_CACHE_TTL_SECONDS=300
ANSWER_CACHE_TTL_SECONDS=120
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
